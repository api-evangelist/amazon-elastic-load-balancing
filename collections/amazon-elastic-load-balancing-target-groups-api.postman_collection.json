          "name": "Amazon Elastic Load Balancing Create a Target Group",
          "request": {
            "name": "Amazon Elastic Load Balancing Create a Target Group",
            "description": {
              "content": "Creates a target group. Target groups are used to route requests to one or more registered targets. After creating a target group, you can register targets and create listeners or rules to route traffic to the target group.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                ""
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "key": "Action",
                  "value": "CreateTargetGroup"
                },
                {
                  "disabled": false,
                  "key": "Name",
                  "value": "<string>",
                  "description": "(Required) The name of the target group. Must be unique per region per account."
                },
                {
                  "disabled": false,
                  "key": "Protocol",
                  "value": "<string>",
                  "description": "The protocol to use for routing traffic to the targets"
                },
                {
                  "disabled": false,
                  "key": "Port",
                  "value": "<integer>",
                  "description": "The port on which the targets receive traffic"
                },
                {
                  "disabled": false,
                  "key": "VpcId",
                  "value": "<string>",
                  "description": "The identifier of the VPC for the targets"
                },
                {
                  "disabled": false,
                  "key": "HealthCheckProtocol",
                  "value": "<string>",
                  "description": "The protocol to use for health checks"
                },
                {
                  "disabled": false,
                  "key": "HealthCheckPort",
                  "value": "<string>",
                  "description": "The port to use for health checks"
                },
                {
                  "disabled": false,
                  "key": "HealthCheckPath",
                  "value": "<string>",
                  "description": "The destination for health checks on the targets"
                },
                {
                  "disabled": false,
                  "key": "TargetType",
                  "value": "<string>",
                  "description": "The type of target to register with the target group"
                }
              ],
              "variable": [
                {
                  "description": "AWS Region",
